# Copy to .env.local (setup.sh writes it for you). Values are the current
# local-dev defaults.

# Channel the test stream is created under. setup.sh fills this with a freshly
# generated, approved channel for the dev user; the value below is an example.
VITE_CHANNEL_ID=978bd64f-3a8c-4196-94cc-03a93e211c87

# Dev user the app logs in as (setup.sh creates + email-verifies it).
VITE_DEV_EMAIL=streamer@local.test
VITE_DEV_PASSWORD=Password123!

# Ports the app talks to (currently hardcoded in source — listed here exactly
# for reference):
#   API   — proxied via /api in vite.config.js : http://localhost:8090
#   Chat  — live-chat WebSocket (packager)     : ws://localhost:8095
#   Vite dev server                            : http://localhost:5173
